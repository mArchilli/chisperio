APP_NAME="Chisperío"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chisperio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PRODUCTOS_IMG_PATH="/productos/img/"
PRODUCTOS_VIDEO_PATH="/productos/videos/"

META_PIXEL_ID=1612606883877046

# Zona horaria de negocio: en qué zona se muestran las fechas y se interpretan "hoy"/"este mes"
# en el panel y las métricas. Lo guardado en la base sigue en APP_TIMEZONE (UTC). Este es el valor por defecto.
# APP_DISPLAY_TIMEZONE=America/Argentina/Buenos_Aires

# Límite de requests por minuto y por IP en los endpoints públicos (config/limites.php). Valores por defecto.
# THROTTLE_CHECKOUT_POR_MINUTO=10
# THROTTLE_VALIDAR_CUPON_POR_MINUTO=30

# Datos del administrador inicial que crea `php artisan db:seed` en un entorno NUEVO de desarrollo (config/seeders.php).
# El seeder nunca corre en producción ni modifica usuarios existentes. Sin contraseña, genera una y la muestra una vez.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NOMBRE=Admin

# --- Integración con el Sistema Central Rukoz (paquete rukoz/core-client) ---
# Interruptor general del paquete: habilita la comunicación con el Central. Apagado no hace nada.
# RUKOZ_INTEGRACION=false
# RUKOZ_CENTRAL_URL=
# RUKOZ_API_KEY=
# RUKOZ_SECRET=
# Webhook que recibe los eventos del Central (stock, 11.2): POST <APP_URL>/rukoz/webhook, firmado, sin sesión ni CSRF.
# Esa URL (https, sin redirecciones) se carga en la integración del Central. El feed (rukoz:poll) lo respalda cada 5 min.
# RUKOZ_WEBHOOK_PATH=/rukoz/webhook
# false si el hosting no puede recibir webhooks (entonces el feed se lee cada minuto).
# RUKOZ_WEBHOOK_RECIBE=true

# Interruptores propios de la web, por etapa (config/integracion.php). Todos apagados hasta la puesta en marcha (11.5).
# INTEGRACION_CATALOGO=false
# 11.2: el stock que muestra y valida la tienda es el «Disponible web» del Central; el admin deja de editarlo. Necesita RUKOZ_INTEGRACION=true,
# el cron de `schedule:run` y la carga inicial: `php artisan chisperio:stock-cargar`. NO encender en producción sin INTEGRACION_CHECKOUT (11.3):
# sin la reserva en el Central el checkout descuenta stock local y el próximo evento del Central lo pisa.
# INTEGRACION_STOCK=false
# 11.3: el pedido reserva el stock en el Central antes de guardarse y la web no descuenta stock local. EXIGE INTEGRACION_STOCK y RUKOZ_INTEGRACION:
# con la combinación inválida el checkout NO usa el Central (queda un warning en el log; `php artisan chisperio:integracion-estado` lo informa).
# El Central tiene que tener sus migraciones al día (la columna `nota` de los ítems de pedidos web) o toda reserva da error.
# INTEGRACION_CHECKOUT=false
# Si el Central no responde al reservar: false (por defecto) = el pedido NO se crea y el cliente ve un mensaje con el botón de WhatsApp; true = se vende
# igual con stock local, sin reserva (el Central no se entera de esa venta). Ver App\Rukoz\CheckoutCentral::permiteVenderSinReserva().
# INTEGRACION_CHECKOUT_SIN_RESERVA=false
# Días sin confirmar a partir de los cuales un pedido con reserva se cancela solo (chisperio:cancelar-reservas-viejas, cada hora). Las reservas del Central no vencen.
# PEDIDOS_CANCELAR_DIAS=3
# Segundos que un pedido recién creado frena un doble envío idéntico (doble clic).
# CHECKOUT_VENTANA_DOBLE_ENVIO=120
# INTEGRACION_CONFIRMACION=false
